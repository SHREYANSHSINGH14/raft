%% raft — clean block map of one node. View at mermaid.live, or: mmdc -i architecture.mmd -o architecture.svg
%% Per-concern diagrams with prose live in docs/architecture.md
flowchart TB
    CLIENT(["app client"])
    PEERS(["peer nodes"])

    subgraph NODE["raft.Node"]
        direction TB
        ROLES["Role engine<br/>Follower · Candidate · Leader"]
        ELECT["Election<br/>pre-vote gate, then request votes"]
        REPL["Replication (leader)<br/>heartbeat · commit-index updater<br/>dynamic fan-out"]
        HAND["Inbound handlers<br/>AppendEntries · RequestVote<br/>PreVote · TimeoutNow · InstallSnapshot"]
        MEMB["Membership<br/>AddMember · RemoveMember"]
        CMT["Commit + Apply<br/>commitCond · apply loop"]
        SNAP["Snapshot<br/>capture · delay-compact"]
    end

    subgraph BND["caller-implemented boundary"]
        TR["Transport"]
        ST["Storage — the log"]
        SM["StateMachine"]
    end

    %% control flow: role drives election vs replication
    ROLES -->|becomes leader| REPL
    ROLES -->|follower / candidate| ELECT

    %% who calls in
    CLIENT -->|Propose| CMT
    CLIENT -->|AddMember / RemoveMember| MEMB
    PEERS -->|inbound RPC| HAND

    %% TimeoutNow and step-down are signals, never direct transitions
    HAND -.->|"timeoutNowCh"| ELECT
    MEMB -.->|"electionTimeoutCh (self-removal)"| REPL
    MEMB -.->|"memberAddedCh · memberRemovedCh"| REPL
    REPL -.->|"leaderCloseCh (step-down)"| CMT

    %% RPCs out
    ELECT --> TR
    REPL --> TR
    MEMB -->|snapshot + catch-up| TR
    TR --> PEERS

    %% commit and apply
    HAND -->|leaderCommit| CMT
    REPL -->|majority matchIndex| CMT
    CMT -->|apply committed| SM
    HAND -->|append / truncate| ST

    %% snapshot + membership coupling
    SNAP -->|capture| SM
    SNAP -->|compact prefix| ST
    HAND & REPL -.->|"prevLog anchor (logTermAt)"| SNAP
    MEMB <-->|"retain floor · catchUpSignal"| SNAP
